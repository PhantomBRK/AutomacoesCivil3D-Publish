<Window x:Class="AutomacoesCivil3D.PlanejadorViasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Planejador de Vias"
        Width="980"
        Height="860"
        MinWidth="880"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="#F2F5F8"
        FontFamily="Bahnschrift">
    <Window.Resources>
        <SolidColorBrush x:Key="HeroBrush" Color="#10324B" />
        <SolidColorBrush x:Key="AccentBrush" Color="#147A8A" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FCFDFE" />
        <SolidColorBrush x:Key="SoftBorderBrush" Color="#D4DEE7" />
        <SolidColorBrush x:Key="TextBrush" Color="#173042" />
        <SolidColorBrush x:Key="MutedBrush" Color="#5F7384" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="BorderBrush" Value="{StaticResource SoftBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderBrush" Value="{StaticResource SoftBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#E6EDF2" />
        </Style>

        <Style x:Key="ChipButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Background="{StaticResource HeroBrush}" CornerRadius="14" Padding="18,14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Planejador de Vias" Foreground="White" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="Desenho interativo de vias urbanas em planta com seções-tipo e junções automáticas"
                           Foreground="#B9CCDA" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Seção-tipo -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Seção-tipo" Style="{StaticResource LabelStyle}" />
                    <ComboBox x:Name="ComboSecoes" Style="{StaticResource ComboStyle}"
                              SelectionChanged="ComboSecoes_SelectionChanged" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Nome (para salvar como nova seção ou sobrescrever)" Style="{StaticResource LabelStyle}" />
                    <TextBox x:Name="TextoNomeSecao" Style="{StaticResource InputStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Salvar seção" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"
                            Click="SalvarSecao_Click" />
                    <Button Content="Excluir / restaurar padrão" Style="{StaticResource SecondaryButtonStyle}"
                            Click="ExcluirSecao_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Preview -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <TextBlock Text="Pré-visualização da seção" Style="{StaticResource LabelStyle}" />
                    <TextBlock x:Name="TextoLarguraTotal" Text="" HorizontalAlignment="Right"
                               FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                </Grid>
                <Border Background="#1D2B36" CornerRadius="10">
                    <Canvas x:Name="CanvasPreview" Height="190" ClipToBounds="True"
                            SizeChanged="CanvasPreview_SizeChanged" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Elementos -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Elementos da seção (da esquerda para a direita, no sentido de caminhamento do eixo)"
                           Style="{StaticResource LabelStyle}" />

                <WrapPanel Grid.Row="1" Margin="0,2,0,6">
                    <Button Content="+ Faixa" Style="{StaticResource ChipButtonStyle}" Tag="Faixa" Click="AdicionarElemento_Click" />
                    <Button Content="+ Acostamento" Style="{StaticResource ChipButtonStyle}" Tag="Acostamento" Click="AdicionarElemento_Click" />
                    <Button Content="+ Estacionamento" Style="{StaticResource ChipButtonStyle}" Tag="Estacionamento" Click="AdicionarElemento_Click" />
                    <Button Content="+ Ciclovia" Style="{StaticResource ChipButtonStyle}" Tag="Ciclovia" Click="AdicionarElemento_Click" />
                    <Button Content="+ Canteiro" Style="{StaticResource ChipButtonStyle}" Tag="Canteiro" Click="AdicionarElemento_Click" />
                    <Button Content="+ Calçada" Style="{StaticResource ChipButtonStyle}" Tag="Calcada" Click="AdicionarElemento_Click" />
                    <Button Content="+ Meio-fio" Style="{StaticResource ChipButtonStyle}" Tag="MeioFio" Click="AdicionarElemento_Click" />
                    <Border Width="16" />
                    <Button Content="◀ Mover" Style="{StaticResource ChipButtonStyle}" Click="MoverEsquerda_Click" />
                    <Button Content="Mover ▶" Style="{StaticResource ChipButtonStyle}" Click="MoverDireita_Click" />
                    <Button Content="Remover" Style="{StaticResource ChipButtonStyle}" Click="RemoverElemento_Click" />
                </WrapPanel>

                <DataGrid x:Name="GridElementos" Grid.Row="2"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          FontSize="13"
                          BorderBrush="{StaticResource SoftBorderBrush}"
                          Background="White"
                          RowBackground="White"
                          AlternatingRowBackground="#F4F8FB"
                          MinHeight="120">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Tipo" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=TiposDisponiveis}"
                                              SelectedItem="{Binding TipoRotulo, UpdateSourceTrigger=PropertyChanged}"
                                              Margin="2" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Largura (m)" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding LarguraTexto, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Background="Transparent" Margin="4,2" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Parâmetros e ações -->
        <Border Grid.Row="4" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="CheckJuncoes" Content="Formar junções automaticamente" IsChecked="True"
                              VerticalAlignment="Center" Margin="0,0,18,0" Foreground="{StaticResource TextBrush}" />
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="Raio de curva do eixo (m)" Style="{StaticResource LabelStyle}" />
                        <TextBox x:Name="TextoRaioEixo" Text="50" Width="90" Style="{StaticResource InputStyle}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Raio do meio-fio na junção (m)" Style="{StaticResource LabelStyle}" />
                        <TextBox x:Name="TextoRaioMeioFio" Text="5" Width="90" Style="{StaticResource InputStyle}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Quantitativos" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                            Click="Quantitativos_Click" />
                    <Button Content="Definir assemblies" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                            Click="DefinirAssemblies_Click" />
                    <Button Content="Gerar corredores" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                            Click="GerarCorredores_Click" />
                    <Button Content="Vias a partir de polylines" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                            Click="ViasDePolylines_Click" />
                    <Button Content="✏ Desenhar via" Style="{StaticResource PrimaryButtonStyle}"
                            Click="DesenharVia_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
